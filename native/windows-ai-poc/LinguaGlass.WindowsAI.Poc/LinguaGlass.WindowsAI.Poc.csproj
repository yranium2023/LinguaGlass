<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64;ARM64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RootNamespace>LinguaGlass.WindowsAI.Poc</RootNamespace>
    <AssemblyName>LinguaGlass.WindowsAI.Poc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Speech remains experimental as of Windows App SDK 2.4. Pin the exact flight. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.1-Experimental" />
  </ItemGroup>
</Project>
